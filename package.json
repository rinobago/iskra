    "type": "commonjs",
    "dependencies": {
        "@tailwindcss/cli": "^4.3.2",
        "hono": "^4.13.16",
        "tailwindcss": "^4.3.2"
    },
    "devDependencies": {
        "concurrently": "^10.0.6",
        "daisyui": "^5.6.13",
        "wrangler": "^4.156.1"
    }
}

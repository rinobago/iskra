{
    "name": "iskra-web",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "concurrently -k \"npm run dev:css\" \"npm run dev:worker\"",
        "dev:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
        "dev:worker": "wrangler dev",
        "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
        "build": "npm run build:css && wrangler deploy"
    },
    "keywords": [],
    "author": "",

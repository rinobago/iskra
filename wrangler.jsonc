{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "iskra",
    "main": "src/index.js",
    "compatibility_date": "2026-11-02",
    "ratelimits": [
        {
            "name": "CONTACT_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 5, "period": 60 },
        },
    ],
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
    },
}
